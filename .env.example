# Application Configuration
APP_NAME="Warehouse Order Management System"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database Configuration (PostgreSQL in Docker / fallback SQLite locally)
# For Docker / PostgreSQL:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/warehouse_db"
DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5432/warehouse_db"

# Local SQLite fallback (auto-enabled if USE_SQLITE=true or postgres unreachable in test)
USE_SQLITE=true
SQLITE_DB_PATH="./warehouse_local.db"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"
USE_FAKE_REDIS=true
CACHE_TTL_SECONDS=300

# Optimization Configuration
DEFAULT_ROUTING_STRATEGY="OR_TOOLS_LP"
MAX_WAREHOUSE_SPLITS=3

# Fault Tolerance & Retries
MAX_RETRIES=3
RETRY_BASE_DELAY=0.1
RETRY_MAX_DELAY=2.0
RETRY_JITTER=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIME=30
